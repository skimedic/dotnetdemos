{
  //https://api.cdnjs.com/libraries?output=human
  //https://api.cdnjs.com/libraries/jquery?output=human
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "defaultDestination": "wwwroot/lib",
  "libraries": [
    {
      "library": "jquery@3.7.1",
      "destination": "wwwroot/lib/jquery",
      "files": [ "jquery.js", "jquery.min.js" ]
    },
    {
      "library": "jquery-validate@1.22.1",
      "destination": "wwwroot/lib/jquery-validation",
      "files": [
        "jquery.validate.js",
        "jquery.validate.min.js",
        "additional-methods.js",
        "additional-methods.min.js"
      ]
    },
    {
      "library": "jquery-validation-unobtrusive@4.0.0",
      "destination": "wwwroot/lib/jquery-validation-unobtrusive",
      "files": [ "jquery.validate.unobtrusive.js", "jquery.validate.unobtrusive.min.js" ]
    },
    {
      "library": "twitter-bootstrap@5.3.8",
      "destination": "wwwroot/lib/bootstrap",
      "files": [
        "css/bootstrap.css",
        "css/bootstrap.min.css",
        "js/bootstrap.js",
        "js/bootstrap.min.js"
      ]
    },
    {
      "library": "font-awesome@7.0.1",
      "destination": "wwwroot/lib/font-awesome/",
      "files": [
        "css/solid.css",
        "css/solid.min.css",
        "css/fontawesome.css",
        "css/fontawesome.min.css",
        "js/solid.js",
        "js/solid.min.js",
        "js/fontawesome.js",
        "js/fontawesome.min.js",
        "webfonts/fa-solid-900.woff2"
      ]
    },
    {
      "library": "popper.js@2.11.8",
      "destination": "wwwroot/lib/popper.js/",
      "files": [
        "umd/popper.min.js",
        "umd/popper.js"
      ]
    }
  ]
}
